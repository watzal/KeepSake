# MongoDB connection string (Atlas or local)
MONGODB_URI=mongodb://localhost:27017
MONGODB_DB=keepsake

# local for development, r2 for Cloudflare R2
STORAGE_BACKEND=local
MEDIA_DIR=media
PUBLIC_API_URL=http://localhost:8000

R2_ACCOUNT_ID=
R2_ACCESS_KEY_ID=
R2_SECRET_ACCESS_KEY=
R2_BUCKET=
R2_PUBLIC_BASE_URL=

# the frontend's address; separate several with commas
CORS_ORIGINS=http://localhost:3000

# Gemma names the photo groups: api (hosted Gemini API) or ollama (local)
# Leave the key empty to skip naming ("Moment 1", "Moment 2", ...)
GEMMA_PROVIDER=api
GOOGLE_API_KEY=

# ElevenLabs reads the trip recap aloud. Leave the key empty to get the script only
ELEVENLABS_API_KEY=

# Clerk sign-in: the same publishable key as the frontend
CLERK_PUBLISHABLE_KEY=

# Sentry tracing. Leave the DSN empty to disable it
SENTRY_DSN=
SENTRY_ENVIRONMENT=development
